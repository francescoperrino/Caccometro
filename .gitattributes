# Source files use CRLF in the working tree on every platform (the repository stores LF).
*.py text eol=crlf
# Shell scripts must stay LF, or the shebang breaks.
.githooks/* text eol=lf
# The infographics are drawn with LF by tools/draw_infographics.py: keep them LF on every clone.
*.svg text eol=lf
# The generated pages are written with LF by their scripts in tools/, like the infographics.
docs/replies.md text eol=lf
docs/functions.md text eol=lf
